generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(CITIZEN)
  points    Int      @default(0)
  createdAt DateTime @default(now())

  issues    Issue[]
}

model Issue {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String
  latitude    Float
  longitude   Float
  status      IssueStatus @default(REPORTED)
  imageBefore String?
  imageAfter  String?
  createdAt   DateTime @default(now())

  userId      String
  user        User @relation(fields: [userId], references: [id])
}

enum Role {
  CITIZEN
  ADMIN
}

enum IssueStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}
